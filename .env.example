# Local development only. Copy to .env and replace all change-me values.
COMPOSE_PROJECT_NAME=oxinov-lms
POSTGRES_DB=oxinov_lms
POSTGRES_USER=oxinov
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432
# Least-privilege API database role (created on first Postgres start; cannot bypass RLS).
APP_DB_PASSWORD=change-me-local-app
REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=6379
MINIO_ROOT_USER=change-me-local-minio-user
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEB_PORT=3000
API_PORT=4000
CHAT_PORT=4001

# Identity. Local HS256 dev tokens (npm run dev:token in backend/api); never set in production.
AUTH_DEV_JWT_SECRET=change-me-local-dev-token-secret-at-least-32-chars
# OIDC provider for real sign-in. Keycloak is the company-platform default:
# AUTH_ISSUER=https://id.oxinov.com/realms/oxinov
# AUTH_JWKS_URL=https://id.oxinov.com/realms/oxinov/protocol/openid-connect/certs
# AUTH_AUDIENCE=oxinov-lms-api

# Local observability. Replace passwords even on a shared development machine.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana
