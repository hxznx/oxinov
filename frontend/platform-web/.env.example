# Copy to frontend/platform-web/.env.local for local development. Never commit real values.
APP_URL=http://localhost:3001
# id.oxinov.com (Keycloak realm) and the confidential portal client (devops/keycloak/configure-realm.sh).
OIDC_ISSUER=http://localhost:8080/realms/oxinov
OIDC_CLIENT_ID=oxinov-platform-web
OIDC_CLIENT_SECRET=change-me-from-keycloak
# api.oxinov.com
PLATFORM_API_URL=http://localhost:4200
# Encrypts the session cookie. At least 32 random characters; rotate to sign everyone out.
SESSION_SECRET=change-me-local-session-secret-at-least-32-chars

# Local only: send the app launcher to local product servers, e.g. edu=http://localhost:3002
# PRODUCT_URLS=edu=http://localhost:3002
