#!/bin/bash
# First boot of the production node (ADR-018): swap, automatic security updates, and the working folder.
# k3s, Helm, and every application arrive with the first deploy (devops/kubernetes/scripts/bootstrap-node.sh
# over Systems Manager), so a rebuilt server converges to the same state without SSH.
set -euo pipefail

# 2 GiB of swap absorbs short memory peaks on the 4 GiB node (k3s runs with fail-swap-on=false).
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon -a

# Security updates only, applied daily without a reboot.
dnf install -y dnf-automatic
sed -i 's/^upgrade_type.*/upgrade_type = security/; s/^apply_updates.*/apply_updates = yes/' /etc/dnf/automatic.conf
systemctl enable --now dnf-automatic.timer

mkdir -p /opt/oxinov
chmod 700 /opt/oxinov
