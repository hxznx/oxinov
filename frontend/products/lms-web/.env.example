# Copy to frontend/products/lms-web/.env.local for local development. Never commit real values.
APP_URL=http://localhost:3002
# id.oxinov.com (Keycloak realm) and the confidential Edu client (devops/keycloak/configure-realm.sh).
OIDC_ISSUER=http://localhost:8080/realms/oxinov
OIDC_CLIENT_ID=oxinov-edu-web
OIDC_CLIENT_SECRET=change-me-from-keycloak
# Oxinov Edu API (backend/products/lms-api), started with AUTH_AUDIENCE=oxinov-lms-api.
EDU_API_URL=http://localhost:4000
# Encrypts the session cookie. At least 32 random characters; rotate to sign everyone out.
SESSION_SECRET=change-me-local-session-secret-at-least-32-chars
# The Oxinov account portal, linked from the header.
ACCOUNT_URL=http://localhost:3001
