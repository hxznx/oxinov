# Copy to backend/api/.env for running the API outside Docker. Local development values only.
NODE_ENV=development
PORT=4000
SERVICE_VERSION=0.1.0
DEPLOY_ENVIRONMENT=local

# Least-privilege request role (cannot bypass row-level security).
DATABASE_URL=postgresql://oxinov_app:change-me-local-app@localhost:5432/oxinov_lms
# Owner role used only for migrations and seeds.
MIGRATION_DATABASE_URL=postgresql://oxinov:change-me-local-postgres@localhost:5432/oxinov_lms

# OIDC identity provider (Keycloak by default). Tokens are verified against its JWKS;
# tenant roles remain in PostgreSQL.
# AUTH_ISSUER=https://id.oxinov.test/realms/oxinov
# AUTH_JWKS_URL=https://id.oxinov.test/realms/oxinov/protocol/openid-connect/certs
# AUTH_AUDIENCE=   # required in staging and production (FR-ID-2207)
# Local-only HS256 tokens from `pnpm --filter @oxinov/lms-api dev:token`. Refused in staging and production.
AUTH_DEV_JWT_SECRET=change-me-local-dev-token-secret-at-least-32-chars
