# Copy to backend/platform-api/.env for running the platform API outside Docker. Local values only.
NODE_ENV=development
PORT=4200
SERVICE_VERSION=0.1.0
DEPLOY_ENVIRONMENT=local

# Least-privilege request role (cannot bypass row-level security).
DATABASE_URL=postgresql://oxinov_platform_app:change-me-local-platform-app@localhost:5432/oxinov_platform
# Owner role used only for migrations and seeds.
MIGRATION_DATABASE_URL=postgresql://oxinov:change-me-local-postgres@localhost:5432/oxinov_platform

# id.oxinov.com (Keycloak). Required together; AUTH_AUDIENCE is required in staging and production.
# AUTH_ISSUER=http://localhost:8080/realms/oxinov
# AUTH_JWKS_URL=http://localhost:8080/realms/oxinov/protocol/openid-connect/certs
# AUTH_AUDIENCE=oxinov-platform-api
# Local-only HS256 development tokens. Refused in staging and production.
AUTH_DEV_JWT_SECRET=change-me-local-dev-token-secret-at-least-32-chars
