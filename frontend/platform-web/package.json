{
  "name": "@oxinov/platform-web",
  "version": "0.1.0",
  "private": true,
  "description": "Oxinov account portal (app.oxinov.com): sign-in, welcome, account home, and product launcher",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/copy-brand.mjs",
    "predev": "node scripts/copy-brand.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@oxinov/design-system": "workspace:*",
    "jose": "6.2.12",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
