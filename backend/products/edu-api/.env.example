# Copy to backend/products/edu-api/.env for running the API outside Docker. Local development values only.
NODE_ENV=development
PORT=4000
SERVICE_VERSION=0.1.0
DEPLOY_ENVIRONMENT=local

# Least-privilege request role (cannot bypass row-level security).
DATABASE_URL=postgresql://oxinov_app:change-me-local-app@localhost:5432/oxinov_lms
# Owner role used only for migrations and seeds.
MIGRATION_DATABASE_URL=postgresql://oxinov:change-me-local-postgres@localhost:5432/oxinov_lms

# OIDC identity provider (Keycloak by default). Tokens are verified against its JWKS;
# tenant roles remain in PostgreSQL.
# AUTH_ISSUER=https://id.oxinov.test/realms/oxinov
# AUTH_JWKS_URL=https://id.oxinov.test/realms/oxinov/protocol/openid-connect/certs
# AUTH_AUDIENCE=   # required in staging and production (FR-ID-2207)
# Local-only HS256 tokens from `pnpm --filter @oxinov/edu-api dev:token`. Refused in staging and production.
AUTH_DEV_JWT_SECRET=change-me-local-dev-token-secret-at-least-32-chars

# Paid courses with Khalti and eSewa (ADR-023). A provider is on only when its keys are set.
# PAYMENTS_MODE=sandbox
# Tenant UUIDs allowed to sell (the seed's Sakura school for local testing).
# PAYMENTS_SELLER_TENANT_IDS=aaaaaaaa-0000-4000-8000-000000000001
# EDU_WEB_URL=http://localhost:3002
# eSewa's published sandbox merchant (not a secret; refused in live mode).
# ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Khalti sandbox: the live_secret_key from test-admin.khalti.com.
# KHALTI_SECRET_KEY=

# Lesson media storage (video and audio lessons). Local S3-compatible server from docker compose
# (`object-storage`); use the OBJECT_STORAGE_* keys from the root .env. Leave MEDIA_BUCKET unset to
# disable media. Create the bucket and its CORS rule once with `pnpm --filter @oxinov/edu-api media:bucket`.
# MEDIA_BUCKET=oxinov-lesson-media-local
# MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=<OBJECT_STORAGE_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<OBJECT_STORAGE_SECRET_KEY>
