# Local development only. Copy to .env and replace all change-me values.
COMPOSE_PROJECT_NAME=oxinov-lms
POSTGRES_DB=oxinov_lms
POSTGRES_USER=oxinov
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432
# Least-privilege API database role (created on first Postgres start; cannot bypass RLS).
APP_DB_PASSWORD=change-me-local-app
# Least-privilege platform API role (database oxinov_platform).
PLATFORM_APP_DB_PASSWORD=change-me-local-platform-app
# Local identity server (profile `identity`): Keycloak database and bootstrap administrator.
KEYCLOAK_DB_PASSWORD=change-me-local-keycloak-db
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin
# Service-account secret for devops/keycloak/configure-realm.sh (any random string, 24+ characters).
KEYCLOAK_AUTOMATION_SECRET=change-me-local-keycloak-automation
REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=6379
# Local S3-compatible object storage (SeaweedFS) for lesson media.
OBJECT_STORAGE_ACCESS_KEY=change-me-local-storage-key
OBJECT_STORAGE_SECRET_KEY=change-me-local-storage-secret-at-least-32
OBJECT_STORAGE_PORT=9000
WEB_PORT=3000
API_PORT=4000
CHAT_PORT=4001

# Identity. Local HS256 dev tokens (`pnpm --filter @oxinov/edu-api dev:token`); never set in production.
AUTH_DEV_JWT_SECRET=change-me-local-dev-token-secret-at-least-32-chars
# OIDC provider for real sign-in. Keycloak is the company-platform default:
# AUTH_ISSUER=https://id.oxinov.com/realms/oxinov
# AUTH_JWKS_URL=https://id.oxinov.com/realms/oxinov/protocol/openid-connect/certs
# AUTH_AUDIENCE=oxinov-lms-api   # required in staging and production
# Per-client requests per minute before 429 RATE_LIMITED (0 disables the in-process limiter).
RATE_LIMIT_PER_MINUTE=600

# Local observability. Replace passwords even on a shared development machine.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana
