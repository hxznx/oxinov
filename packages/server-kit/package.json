{
  "name": "@oxinov/server-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared NestJS building blocks for every Oxinov API: config, token verification, errors, logging, metrics, security events, and HTTP hardening",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "jose": "6.2.12",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "jest": "29.7.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
