# Local Keycloak administration only. Copy to .env and replace every value.
# The real .env file is ignored by Git. Never commit passwords, MFA seeds, or tokens.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin
# Random value of at least 24 characters used only by realm-configuration automation.
KEYCLOAK_AUTOMATION_SECRET=change-me-local-keycloak-automation
