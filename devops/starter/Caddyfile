# Oxinov starter server (ADR-017): TLS from Let's Encrypt, HTTP to HTTPS redirects, and security headers.
{
	email admin@oxinov.com
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	log {
		output stdout
		format json
	}
}

edu.oxinov.com {
	import common
	reverse_proxy edu-web:3002
}

app.oxinov.com {
	import common
	reverse_proxy platform-web:3001
}

id.oxinov.com {
	import common
	# The administration console and the master realm are never public; administrators use a
	# Session Manager port forward to the server instead.
	@private path /admin /admin/* /realms/master /realms/master/*
	respond @private 404
	reverse_proxy keycloak:8080
}
