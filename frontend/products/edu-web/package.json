{
  "name": "@oxinov/edu-web",
  "version": "0.1.0",
  "private": true,
  "description": "Oxinov Edu web app (edu.oxinov.com): workspaces, course catalogue, lessons, and exams",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/copy-brand.mjs",
    "predev": "node scripts/copy-brand.mjs",
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@oxinov/design-system": "workspace:*",
    "@oxinov/web-auth": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
