{
  "name": "@oxinov/web-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend sign-in at id.oxinov.com for Oxinov Next.js apps: PKCE, sealed session cookies, token refresh, sign-out",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/next.ts",
    "./session": "./src/session.ts",
    "./return-to": "./src/return-to.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/web-auth.test.ts"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "next": "16.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
